:80 {
    # API routes: match prefix, strip prefix, proxy to API
    route /v1/* {
        uri strip_prefix /v1
        reverse_proxy http://api:5001
    }

    route /api/* {
        uri strip_prefix /api
        reverse_proxy http://api:5001
    }

    route /console/api/* {
        uri strip_prefix /console/api
        reverse_proxy http://api:5001
    }

    route /files/* {
        uri strip_prefix /files
        reverse_proxy http://api:5001
    }

    route /mcp/* {
        uri strip_prefix /mcp
        reverse_proxy http://api:5001
    }

    # All other requests go to the web app
    handle {
        reverse_proxy http://web:3000
    }
}